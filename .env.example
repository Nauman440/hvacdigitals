# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://hvacdigitals.com

# ---- Indexing -----------------------------------------------------------------
# Leave unset in production: every page is crawlable and indexable.
# Only set to "false" on a staging/preview deploy you want kept out of Google.
NEXT_PUBLIC_ALLOW_INDEXING=

# ---- Google Search Console --------------------------------------------------
# Search Console > Add property > URL prefix > "HTML tag" method.
# Paste ONLY the content value, e.g. for
#   <meta name="google-site-verification" content="abc123XYZ" />
# use: NEXT_PUBLIC_GSC_VERIFICATION=abc123XYZ
NEXT_PUBLIC_GSC_VERIFICATION=

# ---- Google Analytics 4 -----------------------------------------------------
# Defaults to G-PND6GXQJ17 (the ID from the original site). Override if needed.
NEXT_PUBLIC_GA_ID=

# ---- Lead delivery (configure one or both) ---------------------------------
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=HVAC Digitals <leads@hvacdigitals.com>
