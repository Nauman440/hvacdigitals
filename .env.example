# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://hvacdigitals.com

# ---- Indexing -----------------------------------------------------------------
# Leave unset in production: every page is crawlable and indexable.
# Only set to "false" on a staging/preview deploy you want kept out of Google.
NEXT_PUBLIC_ALLOW_INDEXING=

# ---- Google Search Console --------------------------------------------------
# Search Console > Add property > URL prefix > "HTML tag" method.
# Paste ONLY the content value, e.g. for
#   <meta name="google-site-verification" content="abc123XYZ" />
# use: NEXT_PUBLIC_GSC_VERIFICATION=abc123XYZ
NEXT_PUBLIC_GSC_VERIFICATION=

# ---- Google Analytics 4 -----------------------------------------------------
# Defaults to G-PND6GXQJ17 (the ID from the original site). Override if needed.
NEXT_PUBLIC_GA_ID=

# ---- Lead delivery (REQUIRED: without one of these, the form can't deliver leads) ----
# Email via Resend (free tier is plenty): https://resend.com
#   1. Sign up at resend.com with muhammadnauman475@gmail.com
#   2. API Keys > Create API key (Sending access) and paste it below
# Until you verify your own domain in Resend, keep LEAD_FROM_EMAIL empty: the default
# sender (onboarding@resend.dev) can only deliver to the email you signed up with.
RESEND_API_KEY=
# Where lead notifications go (server-side only, never shown on the site).
# Defaults to muhammadnauman475@gmail.com.
# Comma-separate several addresses (only works after you verify a domain in Resend).
LEAD_NOTIFY_EMAIL=
# After verifying hvacdigitals.com in Resend, e.g.: HVAC Digitals <leads@hvacdigitals.com>
LEAD_FROM_EMAIL=

# Optional: also send every lead to a webhook (Zapier, Make, GoHighLevel, n8n, Slack…)
LEAD_WEBHOOK_URL=
